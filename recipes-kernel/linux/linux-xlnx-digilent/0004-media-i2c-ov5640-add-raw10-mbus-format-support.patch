From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 8 Apr 2026 00:00:00 +0900
Subject: [PATCH] media: i2c: ov5640: add RAW10 mbus format support

The Digilent PCam 5C routes the OV5640 over a MIPI CSI-2 RAW10 pipeline.
The vendor ov5640 driver in this tree only advertises JPEG, YUV, RGB565 and
RAW8 Bayer media bus formats. When userspace requests SGRBG10_1X10 on the
subdevice, the driver's format negotiation silently falls back to the first
supported format, which is JPEG_1X8. That leaves the sensor subdevice in JPEG
mode while the Xilinx CSI-2 RX subsystem expects RAW10, preventing streaming.

Advertise the RAW10 Bayer bus formats, program the same Bayer ordering mux as
the RAW8 modes, and switch the MIPI PLL bit mode to 10-bit when one of the
RAW10 formats is selected.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/media/i2c/ov5640.c | 31 ++++++++++++++++++++++++++++---
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/ov5640.c b/drivers/media/i2c/ov5640.c
index d2025d153306..45fe26f09f6d 100644
--- a/drivers/media/i2c/ov5640.c
+++ b/drivers/media/i2c/ov5640.c
@@ -147,10 +147,14 @@ static const struct ov5640_pixfmt ov5640_formats[] = {
 	{ MEDIA_BUS_FMT_SGBRG8_1X8, V4L2_COLORSPACE_SRGB, },
 	{ MEDIA_BUS_FMT_SGRBG8_1X8, V4L2_COLORSPACE_SRGB, },
 	{ MEDIA_BUS_FMT_SRGGB8_1X8, V4L2_COLORSPACE_SRGB, },
+	{ MEDIA_BUS_FMT_SBGGR10_1X10, V4L2_COLORSPACE_SRGB, },
+	{ MEDIA_BUS_FMT_SGBRG10_1X10, V4L2_COLORSPACE_SRGB, },
+	{ MEDIA_BUS_FMT_SGRBG10_1X10, V4L2_COLORSPACE_SRGB, },
+	{ MEDIA_BUS_FMT_SRGGB10_1X10, V4L2_COLORSPACE_SRGB, },
 };
@@
-#define OV5640_PLL_CTRL0_MIPI_MODE_8BIT		0x08
+#define OV5640_PLL_CTRL0_MIPI_MODE_8BIT		0x08
+#define OV5640_PLL_CTRL0_MIPI_MODE_10BIT	0x0a
+
+static bool ov5640_is_10bit_format(u32 code)
+{
+	switch (code) {
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+		return true;
+	default:
+		return false;
+	}
+}
 
 static unsigned long ov5640_compute_sys_clk(struct ov5640_dev *sensor,
 					    unsigned long rate,
@@ -1043,8 +1047,10 @@ static int ov5640_set_pclk(struct ov5640_dev *sensor,
 		}
 	}
 
-	ret = ov5640_mod_reg(sensor, OV5640_REG_SC_PLL_CTRL0,
-			     0x0f, OV5640_PLL_CTRL0_MIPI_MODE_8BIT);
+	ret = ov5640_mod_reg(sensor, OV5640_REG_SC_PLL_CTRL0, 0x0f,
+			     ov5640_is_10bit_format(sensor->fmt.code) ?
+			     OV5640_PLL_CTRL0_MIPI_MODE_10BIT :
+			     OV5640_PLL_CTRL0_MIPI_MODE_8BIT);
 	if (ret)
 		return ret;
 
@@ -2377,6 +2383,21 @@ static int ov5640_set_framefmt(struct ov5640_dev *sensor,
 		/* Raw bayer, RGRG... / GBGB... */
 		fmt = 0x03;
 		mux = OV5640_FMT_MUX_RAW_DPC;
+		break;
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+		/* Raw bayer, BGBG... / GRGR... */
+		fmt = 0x00;
+		mux = OV5640_FMT_MUX_RAW_DPC;
+		break;
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+		/* Raw bayer, GBGB... / RGRG... */
+		fmt = 0x01;
+		mux = OV5640_FMT_MUX_RAW_DPC;
+		break;
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+		/* Raw bayer, GRGR... / BGBG... */
+		fmt = 0x02;
+		mux = OV5640_FMT_MUX_RAW_DPC;
+		break;
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+		/* Raw bayer, RGRG... / GBGB... */
+		fmt = 0x03;
+		mux = OV5640_FMT_MUX_RAW_DPC;
 		break;
 	default:
 		return -EINVAL;
-- 
2.43.0

